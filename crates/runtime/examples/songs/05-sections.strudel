// Sectioned synthwave: a transform arrow nested in sometimesBy through when,
// long chord sequences with repeats, and drum lanes that duck each other.
setcpm(35);

function lead(notes) {
  return note(notes).s("supersaw").release(0.7).gain(1)
}

function chords(notes) {
  return note(notes).s("gm_piano").release(0.3).gain(0.8)
}

function softDrums() {
  return stack(s("bd*4"), s("~ sd ~ sd"), s("hh*8").gain(0.6))
}

function hardDrums() {
  return stack(
    note("a1*4").s("sbd").dist(0.4).gain(0.5)
      .sometimesBy(0.5, (y) =>
        y.when("< 0 [0!3 1]>", (x) => x.clip(0.75).ply("<2 2 2 4>"))
      )
      .orbit(2)
      .duckorbit(1),
    note("[~ [a2]]*2").s("sbd").penv(6).dec(0.4).orbit(2),
    s("[~ white]*2").dec(0.3).bpf(3000).bpq(0.5).orbit(2),
    s("[~ [oh:2:0.5 ~ ~ ~] oh:2 ~]*4").dec(0.2).orbit(2).att("[0.15 0]*4").velocity(1.2).pan(0.6)
  )
}

const sections = {
  intro: stack(
    lead(`<[- - c4 e4] [a3 c4] [[f4, f5] - - - [f4, f5] - - [e4, e5]] [[f4, f5] [g4, g5] - [c4, c5] - [e4, e5] - -]>`),
    chords(`<[[f1, f2] [a2, c3, f3] [c3, a3] [g2, e3]] [[c1, c2] [e3, f3] [c3, a3] [g2, e3]]>`)
  ),

  verse: stack(
    lead(`<[[f4, f5] - - - [f4, f5] - - [e4, e5]] [[f4, f5] [g4, g5] - [c4, c5] - [e4, e5] - -]>`),
    chords(`<[[c3, c2] e4 [f3, a3] e4 c3 e4 [f3, a3] e4] [c3 e4 [f3, a3] e4 c3 e4 [f3, a3] e4]>`),
    softDrums()
  ),

  chorus: stack(
    lead(`<[[e4, a4, c5] - d5 d5 - e5 c5 -] [- - - - e5 d5 e5 d5] [[e4, a4, c5] - d5 d5 - e5 c5 -] [- - d5 e5]>`),
    chords(`<[c2 g2 c3 f3 - c3 - g2]!2 [f2 c3 f3 a3 - f3 - c3]!2>`),
    hardDrums()
  ),

  bridge: stack(
    lead(`<[- - [c4, c5] [c4, c5] [d4, d5] [e4, e5] - [g4, d5, g5]] [- [c4, c5] - [d4, d5] - [e4, e5] - -]!2>`),
    chords(`<[[a1, a2] f2 a2 d3 - a2 - f2]!2 [[f1, f2] c3 f3 [a2, c3] - f3 - c3] [f2 c3 f3 [a2, c3] - f3 - c3]>`),
    hardDrums()
  ),

  outro: stack(
    lead(`<[[c5, d5]] [[a4, c5] - - [c5, c6] - [d5, e5] - -] [f4 - a4 - c5 - e5 f5]>`),
    chords(`<[c2 g2 c3 [f3, a3] - c3 - g2]!2 [f2 c3 f3 [a3, c3] - f3 - c3]!2>`)
  )
};

$:
  "<intro@2 verse@4 chorus@4 bridge@4 chorus@4 outro@4>"
    .pickRestart({...sections});
