$: s("cr:0 <lt ~> rim <rd ht rim> cr:2 [bd:2 rd [sd:3 hh hh:2 bd] clap!2 <clap bd> ht rim@2 <cr cb cp>?] rd:2").euclidRot(5,8,7).euclidRot(4,16,3)
