$: s("[ht cr:3 hh [mt? rd:2 lt cp? hh?] cr@2 [bd:0 rd/2 mt? bd mt rd] cp] mt*4? cr*2 [<cb ht bd> rd rim sd*2 <sd rim> rd:0 ~*4 <cb lt>*4] <oh rd ht> rd!2*2 rim").every(6, (x => x.rev())).leslie(4).drive(0.17).leslie(2).adsr("0.02:0.16:0.51:0.321")
