/*
  @title Tutti Stress
  @by undy-aeon
  @origin rustel
  @duration 4
*/
// Heaviest loader case in the corpus: 22 tracks on 22 sample banks,
// all demanded on the first cycle. Original material.
setcpm(43)

// Track 1: taiko pulse
$: note(`<
    [E2@2 - E2@2 D1@2 C1@2 - C1@2 -] [B1 B1 A1 A1 A1 B1 B1 -]@2 [A1 A1 A1 A1] -
>`).sound("gm_taiko_drum").gain(0.42)

// Track 2: melodic toms
$: note(`<
    [F#3@3 G3@3 A3@3 B3@3 A3@3 A3@3 - B3@3] [B3 B3 B3 A3 - -] [A3 B3 B3 C3]@3 -
>`).sound("gm_melodic_tom").gain(0.34)

// Track 3: contrabass
$: note(`<
    [G1@4 F#1@4 E1@4 D1@4 D1@4 D1@4 C1@4 C1@4] [B1@4 - B1@4 B1@4 B1@4 B1@4 C1@4 D1@4] [E1 - D1 C1 D1 E1 D1 C1]@2 -
>`).sound("gm_contrabass").gain(0.38).release(0.03)

// Track 4: cello roots
$: note(`<
    [E3 G3 B3]@12 [B3 D3 F#4]@8 [E3 G3 B3]@16 [B2 E3 G3]@12 -
>`).sound("gm_cello").gain(0.3).release(0.08)

// Track 5: viola inner
$: note(`<
    [C3 E4 C3 D3 D3 D3 B3 D3]@2 [F#4 G4 G4 F#4 E4 D3 F#4 G4] [E4@2 C3@2 A3@2 B3@2 A3@2 B3@2 - C3@2] [E4 - E4 E4 D3 - D3 E4] -
>`).sound("gm_viola").gain(0.26).release(0.05)

// Track 6: violin melody
$: note(`<
    [- B4@3 C4@3 A4@3 A4@3 G4@3 G4@3 G4@3] [B4@2 G4@2 G4@2 G4@2 A4@2 B4@2 C4@2 -] [D4@4 B4@4 B4@4 G4@4 B4@4 A4@4 A4@4 -] [G4@2 - B4@2 D4@2 - B4@2] -
>`).sound("gm_violin").gain(0.28).release(0.06)

// Track 7: string ostinato
$: note(`<
    [G3@2 A3@2 B3@2 - G3@2 E3@2 C2@2 E3@2 C2@2 C2@2 E3@2 D2@2 D2@2 D2@2 B2@2 C2@2] [A2 B2 C2 C2 B2 - A2 - A2 B2 C2 A2 C2 E3 D2 -] [E3@2 F#3@2 E3@2 C2@2 - E3@2 D2@2 C2@2 D2@2 B2@2 D2@2 E3@2 - C2@2 A2@2 -] [- A2 C2 - C2 E3 G3 B3 C3 B3 D3 F#4 G4 G4 E4 G4]@2 [- G4 F#4 E4 C3 D3 E4 F#4] -
>`).sound("gm_string_ensemble_2").gain(0.24).release(0.02)

// Track 8: pizzicato
$: note(`<
    [C3 - - - E4 - F#4 F#4 D3 C3 - B3 B3 D3 - D3] [E4 - D3 C3 - - D3 - E4 G4 - - F#4 F#4 G4 G4]@2 [G4 E4 E4 D3 F#4 - - G4 - - - - F#4 F#4 - -] -
>`).sound("gm_pizzicato_strings").gain(0.26)

// Track 9: flute counter
$: note(`<
    [G4@3 - F#4@3 A4@3 G4@3 E4@3 F#4@3 E4@3] [E4@2 C3@2 E4@2 C3@2 A3@2 C3@2 A3@2 C3@2] [D3@4 B3@4 A3@4 A3@4 C3@4 D3@4 E4@4 G4@4] [B4@2 - - D4@2 B4@2 G4@2] -
>`).sound("gm_flute").gain(0.24).release(0.05)

// Track 10: piccolo runs
$: note(`<
    [F#5 F#5 F#5 E5 G5 F#5 D4 B4 A4 A4 B4 C4 A4 A4 A4 A4] [A4 B4 C4 B4 A4 A4 A4 A4 A4 A4 C4 A4 C4 A4 C4 C4] [B4 A4 A4 A4 A4 A4 A4 - C4 E5 G5 G5] [E5 G5 A5 B5 C5 A5 A5 F#5]@2 -
>`).sound("gm_piccolo").gain(0.16).release(0.02)

// Track 11: oboe line
$: note(`<
    [A3@3 B3@3 C3@3 D3@3 F#4@3 G4@3 G4@3 E4@3] [F#4@2 - D3@2 D3@2 E4@2 C3@2 - A3@2] [C3@4 E4@4 E4@4 D3@4 - D3@4 E4@4 C3@4] [C3@2 D3@2 B3@2 - D3@2 F#4@2] -
>`).sound("gm_oboe").gain(0.22).release(0.05)

// Track 12: clarinet arpeggio
$: note(`<
    [F#3 G3 F#3 F#3 F#3 E3 E3 E3]@2 [- D2 C2 C2 A2 A2 C2 D2] [B2@2 B2@2 A2@2 - B2@2 - D2@2 E3@2] [E3 F#3 G3 A3 - F#3 - A3] -
>`).sound("gm_clarinet").gain(0.22).release(0.04)

// Track 13: bassoon staccato
$: note(`<
    [E3@4 F#3@4 E3@4 F#3@4 F#3@4 E3@4 F#3@4 G3@4] [A3@4 G3@4 A3@4 G3@4 G3@4 A3@4 A3@4 G3@4] [G3 G3 A3 A3 - B3 B3 C3]@2 -
>`).sound("gm_bassoon").gain(0.28).release(0.02)

// Track 14: brass pads
$: note(`<
    [E3 G3 B3]@12 [B3 D3 F#4]@8 [E3 G3 B3]@16 [B2 E3 G3]@12 -
>`).sound("gm_brass_section").gain(0.22).release(0.1)

// Track 15: trumpet fanfare
$: note(`<
    [E4 B4 E5]@2 - - [E4 B4 E5]@3 - - - -
>`).sound("gm_trumpet").gain(0.26).release(0.06)

// Track 16: trombone stabs
$: note(`<
    [E3 B3 E4]@2 [E3 B3 E4]@2 - - [B2 E3 B3]@4 - -
>`).sound("gm_trombone").gain(0.28).release(0.05)

// Track 17: tuba pedal
$: note(`<
    C1@12 D1@8 C1@16 - -
>`).sound("gm_tuba").gain(0.3).release(0.08)

// Track 18: harp arpeggio
$: note(`<
    [F#3 D2 B2 A2 A2 A2 A2 C2 D2 E3 E3 F#3 F#3 A3 - G3]@2 [B3 G3 B3 A3 G3 E3 F#3 A3 G3 G3 A3 G3 A3 B3 D3 C3] [D3@2 D3@2 B3@2 A3@2 B3@2 - - C3@2 C3@2 C3@2 C3@2 B3@2 B3@2 G3@2 F#3@2 G3@2] [- F#3 A3 F#3 E3 G3 G3 F#3 A3 - - F#3 A3 C3 A3 F#3] -
>`).sound("gm_orchestral_harp").gain(0.2)

// Track 19: celesta figuration
$: note(`<
    [D4 E5 D4 D4 D4 C4 D4 F#5 F#5 G5 A5 C5 E6 D5 C5 D5] [C5 D5 C5 E6 F#6 G6 G6 E6 - C5 D5 D5 - C5 A5 G5] [F#5 - E5 C4 C4 E5 C4 B4 D4 B4 B4 D4] [D4 D4 E5 F#5 E5 C4 D4 D4]@2 -
>`).sound("gm_celesta").gain(0.16)

// Track 20: xylophone runs
$: note(`<
    [F#5 E5 F#5 D4 D4 C4 A4 A4 B4 A4 B4 C4 A4 B4 A4 A4] [A4 A4 C4 A4 B4 D4 C4 D4 D4 - E5 F#5 F#5 D4 F#5 F#5] [F#5 D4 E5 - C4 - A4 A4 A4 A4 B4 -] [B4 B4 C4 A4 A4 B4 D4 F#5]@2 -
>`).sound("gm_xylophone").gain(0.18)

// Track 21: choir bed
$: note(`<
    D2@12 D2@8 C2@16 - -
>`).sound("gm_choir_aahs").gain(0.2).release(0.2)

// Track 22: orchestra hits
$: note(`<
    [E3 B3 E4]@2 [E3 B3 E4]@2 - - [B2 E3 B3]@4 - -
>`).sound("gm_orchestra_hit").gain(0.24)
