// "stackadoodle" @by bawbewa

stack(
  
  sound(`<
    [bd ~ sd ~ bd ~ bd sd bd bd]
    [bd ~ sd ~ bd ~ bd sd ~  sd]
  >`)
  .bank('KorgDDM110')
  .lpf(2600),

  sound(`
    [<hh hh>]
  `)
  .bank('AkaiXR10')
  .hpf(6000)
  .gain("<.05 .2 .05 .4>")
  .fast(10),

  note(`<
    [ab1 ~ <c2 eb2> ~ <eb2 c2> ~ ~ <f2 ab2> ~ g2] *4
    [g1  ~ <b1 c2> ~ <c2 b1>  ~ ~ <f2 b1> ~ g2] *4
  >`)
  .sound('gm_synth_bass_2')
  .gain(1.5)
  .lpf(1600)
  .slow(4),

  note(`
    [ g4  eb4 ab3 c4  g4  |
      ab3 eb4 c4  g4  ab3 |
      c4  g4  eb4 ab3 c4  |
      eb4 g4  ab3 c4  eb4 ] * 8
    [ g3  b3  f4  c4  g3  |
      f4  b3  c4  g3  f4  |
      c4  g3  d4  f4  c4  |
      b3  g3  f4  c4  b3  ] * 8
  `)
  .sound('gm_pizzicato_strings')
  .decay(.2)
  .gain(1.5)
  .hpf(1000)
  .slow(8)
  .delay(".25:<.1 1.2 .3 1.4 .5>:<0 .5 .99>")
  .room(.2),

  sound("wind:0 | wind:1 | wind:2 | wind:7")
  .struct("<1 0 1 0 1 0 1 0>")
  .room(4),

)

// @version 1.0
