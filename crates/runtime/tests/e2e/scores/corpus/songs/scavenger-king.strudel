//@title Scavenger King
//@by Goose

stack(
   //ryo
n("1 2, <12 14 12 10 [12  12] 10>*2")
.sound ("gm_slap_bass_1")
   .room (.3)
   // .attack > 0.04 takes away its edge
   .attack (.1).release (.3)
   ,
   n ("A Bb Gb, A E Cb Gb Ab A").cpm (30)
   .s ("gm_electric_guitar_clean")
   .scale ("c:minor")
   .gain (3).room (.2)
  .attack(.1).sustain (.7).release (.2)
   ,
   n ("5 2 3 4 10")
.s ("gm_distortion_guitar")
   .gain (.6).lpf (2000) 
   .attack (.2) // makes it bearable, kinda like a violin
   ,
// bd in seg 2 creates the thumping heartbeat
   sound ("bd bd bd [bd bd], <bd lt [bd, hh, lt] [hh hh bd hh@2 lt lt bd]>")
.bank ("BossDR220")
  .gain("1 1.3") //gain enforces the beat
  ,
  n ("<4 5 3 6 8 9 7 12, 6 7 5 8>*4")
.s ("gm_violin")
  .scale ("c:minor")
  .room (1),

  n("<~@6 16@2 ~@6 17@2 ~@6 15@2 ~@6 18@2>*4")
.s ("gm_violin")
  .scale ("c:minor")
  .room (2) .lpf (2500).gain (.8)
  .attack (.1).release (.4)
   )

// @version 1.0
