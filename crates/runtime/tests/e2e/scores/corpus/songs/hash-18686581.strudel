// ==================== HAT (open -> white noise) ====================
const h1 = s("[pink*3]!4")
const h2 = s("[~ pink pink][pink*3]!3")
const h3 = s("[pink ~@2]!4")
const h4 = s("[pink@2 ~][pink@3][pink@2 ~][pink@3]")
const h5 = s("[pink*3]!2 [pink ~@2] ~")
const h6 = s("~ [pink@3][pink@2 ~][pink@3]")
const h7 = s("[pink@2 ~][pink@3][pink@2 ~]!2")
const h8 = s("[pink ~ ~] ~ ~ ~")

