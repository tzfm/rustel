/*
  @title Slaughter of the Toad (At the Gates - Slaughter of the Soul cover with the Battletoads soundfont)
  @by awesome-strudel
  @origin songs-awesome
  @duration 4
*/
setcpm(157/4)

// Mute controls

const LEAD_GUITAR    = 1
const HARMONY_GUITAR = 1
const BASS           = 1
const DRUMS          = 1
const FX             = 1

// Sections

const INTRO = 13 //13
const V1    = 8  //8
const C1    = 4  //4
const PC1   = 8  //8
const V2    = 8  //8
const C2    = 4  //4
const B1    = 16 //16
const SOLO  = 16 //16
const C3    = 8  //8
const V3    = 8  //8
const C4    = 25 //25
const END   = 20

// ==================== KICK ====================
const k1 = note("[c2 ~ c2][~ c2 ~][c2 ~ c2][~ c2 ~]")
const k2 = note("[c2*3]*4")
const k3 = note("[c2 ~@3]")
const k4 = note("[~ c2 c2][c2*3]")
const k5 = note("[c2*3]!3 [c2 c2 [c2 c2]]")
const k6 = note("[c2*3][c2 c2 [c2 c2]] ~ c2")
const k7 = note("[c2@2 c2][c2*3]!3")
const k8 = note("[~ ~ c2][c2 c2@2][c2@2 [c2 c2]] ~")
const k9 = note("[c2@2 c2] ~ [c2@2 c2] ~")
const k10 = note("c2 c2 c2 c2")
const k11 = note("[c2 ~ c2][~ c2 ~] ~@2")
const k12 = note("c2 ~@2 [~@2 [c2 c2]]")
const k13 = note("c2")
const k14 = note("[c2 ~ c2][~ c2 ~][c2 ~@2] ~")
const k15 = note("[c2@2 c2] ~ [c2@2 c2][~@2 [c2 c2]]")
const k16 = note("[c2 ~@2] ~@3")
const k17 = note("[c2 ~ c2][~ c2 ~] c2 c2")
const k18 = note("[c2*3]!2 [c2 ~@2] ~")
const k19 = note("[c2@2 c2] c2 ~@2")

// Bars 1-13 (Intro)
const kIntro = arrange(
  [3, silence],
  [1, k10],
  [1, k13],
  [7, k1],
  [1, k14]
)
// Bars 14-21 (Verse 1)
const kV1 = arrange(
  [7, k1],
  [1, k11]
)
// Bars 22-25 (Chorus 1)
const kC1 = arrange(
  [1, k7],
  [2, k2],
  [1, k6]
)
// Bars 26-33 (Post-Chorus)
const kPC1 = arrange(
  [6, k1],
  [1, k10],
  [1, k3]
)
// Bars 46-61 (Bridge)
const kB1 = arrange(
  [7, k2],
  [1, k6],
  [2, k3],
  [1, k12],
  [1, k8],
  [2, k3],
  [1, k12],
  [1, k4]
)
// Bars 62-77 (Solo)
const kSolo = arrange(
  [1, k9],
  [1, k2],
  [1, k9],
  [1, k2],
  [1, k9],
  [1, k2],
  [1, k15],
  [1, k4],
  [1, k7],
  [6, k2],
  [1, k6]
)
// Bars 78-85 (Chorus 3)
const kC3 = arrange(
  [2, k2],
  [1, k5],
  [1, k8],
  [2, k2],
  [1, k5],
  [1, k4]
)
// Bars 86-93 (Verse 3)
const kV3 = arrange(
  [7, k1],
  [1, k16]
)
// Bars 94-118 (Chorus 4)
const kC4 = arrange(
  [3, k1],
  [1, k17],
  [7, k2],
  [1, k18],
  [2, k2],
  [1, k5],
  [1, k4],
  [2, k2],
  [1, k5],
  [1, k8],
  [2, k2],
  [1, k5],
  [1, k4],
  [1, k19]
)

$kick: arrange(
  [INTRO, kIntro],
  [V1,    kV1],
  [C1,    kC1],
  [PC1,   kPC1],
  [V2,    kV1],
  [C2,    kC1],
  [B1,    kB1],
  [SOLO,  kSolo],
  [C3,    kC3],
  [V3,    kV3],
  [C4,    kC4],
  [END,   silence]
).sound("bd").gain(0.6)


// ==================== SNARE ====================
const s1 = note("~ [c2 ~ ~] ~ [c2 ~ ~]")
const s2 = note("[~ c2 ~][c2 ~ c2][~ c2 ~][c2 ~ c2]")
const s3 = note("[c2@2 ~] ~@3")
const s4 = note("~@2 c2 ~")
const s5 = note("~ [c2 ~ ~] c2 ~")
const s6 = note("~ c2 ~ c2")
