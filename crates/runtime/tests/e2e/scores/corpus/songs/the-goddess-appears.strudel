[eb4 bb gb eb]


[bb4 eb4 cb4 ab]
[ab4 eb4 cb4 ab] 
[g4 eb4 cb4 ab]
[ab4 eb4 cb4 ab]

[cb5 fb4 db4 g]
[bb4 fb4 db4 g]
[a4 fb4 db4 g]
[bb4 fb4 db4 g]

