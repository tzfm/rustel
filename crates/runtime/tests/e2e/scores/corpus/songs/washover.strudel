n("{0 1 3 5 2 }%16")
  .add(n(tri.range(0, 6).slow(3)))
  .scale("C4:pentatonic")
  .sound("sawtooth").att(saw.range(0, 0.05).fast(6))
  .release(3).pan(rand).decay(rand.range(0.1, 0.3))
  .lpf(tri.range(200, 8000).slow(5)).lpq(0)
  .gain(.4).vib(1).vibmod(.1)
  .scope()


