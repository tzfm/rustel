/*
  @by strudel community bakery
  @origin songs-bakery
  @duration 4
  @source https://strudel.cc/?Cnmy1oAosTVU
*/
typeof setDefaultVoicings !== 'undefined' && setDefaultVoicings('legacy') // https://github.com/tidalcycles/strudel/pull/967
// "Kakariko Village Contrafact" @by froos

chord("<Bb Gm C7sus F7>")
  .dict("ireal")
  .layer(
    x=>n("0 1 2 3 2 1").set(x).voicing()
      .clip(2).s("gm_electric_guitar_muted")
    ,
    x=>n("<[0@5 -1] 1 [3 2] 1>".add.mix("<8!3 [10 9 5]>").add("<0 4 3 1>/4"))
      .set(x)
      .juxBy(.5, x=>x.rev().mask("<0 1>/16").sub(n(2)))
      .voicing()
    .s("gm_pan_flute:1")
      .gain(.25).delay(.5).lpf(1200).vib("4:.1")
    ,
    x=>n("<0 <1 0>>*2").set(x).mode("root:f2").voicing()
      .s("gm_acoustic_bass").mask("<0 1 1 1>/4")
  ).room(.5)

// @version 1.0
