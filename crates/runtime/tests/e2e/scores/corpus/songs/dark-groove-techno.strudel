/*
  @title Dark groove techno
  @by Enelg
  @origin songs-bakery
  @duration 4
  @source https://strudel.cc/?BqSVVMaJ1bvu
*/
// "Dark groove techno" @by Enelg

setcps(130/4/60)


const kick = stack(
      s("bd*4")
      .bank("RolandTR909"),
      s("gm_taiko_drum*4")

  )
.off(3/16, x=> x.gain("<.2!7 .4>*4"))

kick: 
  kick.decay(.8)
  .lpf(500)
.dist("1.3:1")
// .hush()

rumble: 
  stack(
    kick
      .attack(.2)
      .delay(.4)
      .room(.1)
      .pan(.5)
      .lpf(300)
      .dist(.5)
      .mul(gain(saw.range(.3,1).fast(4)))    //side chain
      // .hush()
,
    kick
      .attack(.1)
      .delay(".1:.125")
      .bpf(700)
      .dist(.8)
      .mul(gain(saw.range(0,2).fast(4)))    //side chain
      .decay(.2)
      // .hush()
    ,
    
).lpf(1000)
// .hush()


hihat: s("[~ [oh,hh,rim]]*4")
  .bank("RolandTR909")
  .decay(.3)
  .dist(".3:.3")
  .mul(gain("[.2 1]*4"))
  .pan(tri.range(.7,.3))
  .delay(.1)
  .hpf(1000)
  // .hush()

white: sound("white")
  .euclid(3,8)
  .decay(.5)
  .attack(.05)
  .lpf(saw.range(1000,6000).slow(8))
  .hpf(500)
  .dist("1:.2")
  .pan(sine.range(.2,.8).slow(3))
  // .hush()


bass: note("<a1 c2 d2 f2>/2")
.sound("supersaw")
.euclidLegato(5,16)
.ftype('24db')
.lpf(tri.rangex(2000,400).slow(8))
// .hpf(400)
.lpenv(6)
.dist("2:.4")
.echo(2, 1/16, .7)
.mul(gain("[.5 1]*4"))
// .hush()


synth: note("a2*16")
.sound("sawtooth")
.decay(.3)
.ftype('24db')
.lpf(saw.rangex(400,3000).slow(8).mul(.4))    //.4 -> 2
.hpf(400)
.lpenv(saw.range(1,6).slow(8))
.lpq(8)
.delay(.3)
.dist("1:.2")

.echoWith(3,1/16, p => p.pan(sine))  //ping pong
.mul(gain("[.3 1]*4")) //side chain
.mul(gain(saw.range(.6,.2).slow(8)))
// .hush()

// @version 1.0
