// "Reverie test" @by Smooth_head_corner
stack (
n("{0 1 3 5 <6 7 8> <~@6 9 10> }%<16 24 18>")
  .add(n(rand.range(0, 6).slow(2)))
  .scale("A3:ionian")
  .sound("dantranh").att(saw.range(0, 0.1).fast(6))
  .release(3).pan(rand).decay(rand.range(0.1, 0.5))
  .lpf(tri.range(80, 2500).slow(5)).lpq(tri.range(0, 10).fast(tri.range(0, 16)))
  .gain(rand.range(0.8, 1)).clip(1)
  ,
  n("{0 2 4 6 <5 4 3> <~@5 6 7> }%<20@2 12>")
  .scale("E3:pentatonic")
  .sound("dantranh").att(saw.range(0, 0.1).fast(6))
  .release(3).pan(rand).decay(rand.range(0.1, 2))
  .lpf(tri.range(1000, 7500).slow(5)).lpq(tri.range(0, 10).fast(tri.range(0, 16)))
  .gain(rand.range(0.6, 0.9)).clip(1)
  ,
  n("[0 .. 12]*<1.5 2 0.75 2.25>")
  .scale("A4:ionian E3:pentatonic")
  .sound("handchimes").att(saw.range(0, 0.1).fast(6))
  .release(3).pan(rand).decay(rand.range(0.1, 2))
  .hpf(tri.range(3000 , 7500).slow(5)).lpq(tri.range(0, 10).fast(tri.range(0, 16)))
  .gain(rand.range(0.15, 0.3))
  .sometimesBy(0.5, x=>x.jux(rev)).clip(1)
 )
.speed(rand.range(1 , 1.02))
.vib(1).vibmod(.1)
.room(1)

// @version 1.0
