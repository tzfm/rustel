/*
  @by rustel maintainers
  @origin songs-user
  @duration 4
*/
setCpm(120/4)
register('localFill', function (pat) {
  return new Pattern(function (state) {
    const lookbothways = 1;
    // Expand the query window
    const haps = pat.query(state.withSpan(span => new TimeSpan(span.begin.sub(lookbothways), span.end.add(lookbothways))));
    const onsets = haps.map(hap => hap.whole.begin)
      // sort fractions
      .sort((a, b) => a.compare(b))
      // make unique
      .filter((x, i, arr) => i == (arr.length - 1) || x.ne(arr[i + 1]));
    const newHaps = [];
    for (const hap of haps) {
      // Ingore if the part starts after the original query
      if (hap.part.begin.gte(state.span.end)) {
        continue;
      }

      // Find the next onset, to use as an offset
      const next = onsets.find(onset => onset.gte(hap.whole.end));

      // Ignore if the part ended before the original query, and hasn't expanded inside
      if (next.lte(state.span.begin)) {
        continue;
      }

      const whole = new TimeSpan(hap.whole.begin, next);
      // Constrain part to original query
      const part = new TimeSpan(hap.part.begin.max(state.span.begin), next.min(state.span.end));
      newHaps.push(new Hap(whole, part, hap.value, hap.context, hap.stateful));
    }
    return newHaps;
  });
});

register('inspire', (_scale, density, octaves, seed, bars, x) => {
  return x.n(rand.range(0,pure(12).mul(octaves)))
    .scale(_scale)
    .sometimesBy(pure(1).sub(density), x => x.mask(rand.round()))
    .early(rand2.range(-0.001, 0.001))
    .localFill()
    .rib(seed, bars)
})

$: s("bd:10!4").sometimesBy(0.1, x=>x.ply("2|3|4")).rib(10, 3).duckorbit(2).duckatt(0.1).gain(0.2).dec(0.05)
$: s("oh:10").beat("1,3,5,7", 8).decay(0.07).velocity(tri.range(0.2, 1).fast(2)).gain(0.2)
$: s("piano").seg(8).inspire("<ab:major>", 0.4, 2, 10, 4).dec(1).delay(0.1).gain(0.2).orbit(2)
$: s("piano").seg(8).inspire("<ab:major>", 0.5, 12/12, 14, 4).transpose("-24,-12").dec(1).gain(0.1).orbit(2)
$: s("piano").seg(8).inspire("<ab:major>", 0.9, 12/12, 14, 2).transpose("-24").dec(1).gain(0.1).orbit(2)
$: s("piano").seg(8).inspire("<ab:major>", 1, 1/12, 15, 2).transpose("<-24,12!2 <-24, 7> <-12, 9> <-12, 10>>").dec(0.5).delay(0.2).gain(0.1).orbit(2)
$: s("piano").seg(8).inspire("<ab:major>", 1, 1, 70, 4).transpose(12).dec(0.7).delay(0.3).gain(0.4).orbit(2)
$: s("piano").seg(16).inspire("<ab:major>", 0.2, 1, 60, 4).dec(0.6).room(0.1).delay(0.3).gain(0.2).orbit(2)
$: s("piano").seg(4).inspire("<ab:major>", 1, 2, 42, 2).transpose("<<-36,-12, 0> <-36, -22, -10, [[[-5 <-3, -5, 2>] -3]]>>").dec(1).room(1).gain(0.1).orbit(2)
