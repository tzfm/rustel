/*
  @title The Cure: Close to me - Cover
  @by leo
*/

setcpm(25)
  stack(
    //drums
    s(" bd@2 cp bd@3 cp@3 bd cp@2 bd bd cp@2").fast(4),
//melody
  note("[g5 ~ ~ f5 ~ ~ e5 ~ c5 ~@7]!2 [c6 ~ ~ b5 ~ ~ g5 ~ ~@8] [b5 ~ ~ g5 ~ ~ d5 ~ ~@8]").sound("gm_xylophone ").room(0.25).color("green")
  ,
  //bass
  note("[[c2 ~ ~ c2 ~ ~ c2 ~] [~ c2!3 f2!2 e2 ~]] [[c2 ~ ~ c2 ~ ~ c2 ~] [~ c2!3 d2!3 ~]] [[a2 ~ ~ a2 ~ ~ a2 ~] [~ a2!3 b2!2 b2 ~]] [[g2 ~ ~ g2 ~ ~ g2 ~] [~]] ")
  .sound("gm_electric_bass_finger").color("red"), 
//chords
note("[g, c4, e4]@3 [b, d4, g4] [g, c4, e4]@3 [a, c4, f4] [g, c4, e4]@4 [[g, b, d4] ~ ~ [g, b, d4] ~ ~ [g, b, d]~]@2 [~]@2 ").gain(0.5).color("blue")
    ).slow(4)
.pianoroll()


