/*
  @by awesome-strudel
  @origin songs-awesome
  @duration 4
*/
// @title Vegetable Valley - Kirby's Adventure
// @by Hirokazu Ando
// transcribed @by tzwaan

setCpm(180/4)

all(x=>stack(x.filterWhen(t=>t<8),x.rib(8,32).late(8).filterWhen(t=>t>= 8)))

$:n(`<
[[[[<0 1 4>-]*15]@30 0 0]@2<[[[<1 3 7>-]*9]@18 1 - 3 - 5 - 6 - 11!2 18!2 11!2]@2[[<1 2 3 5 7 5 7 9 8 11 10 9 8>-]*13@26 -!6]@2>*2@2]*2@8
[[[[[-5@6 -5 -3][1 0]][-1[-2@3 -1]-3<-5 0>]<[[-4@6 -2 0]@2 4[3@3 2]][1@5 8*2 4 -][[1@6 2b 2]@2 3[5@3 4]][4@5[4,3]*2[4,3]-]>*2@2]*2
[[[0#@3 1][[2 -]7#]<[6[3#@3 4#]][6@6 3# 4#]>@2][5[2@3 5]<1#[1#[2 - 3# -]]>@2]<[[2@3 3#][[4 -]9]8[7@3 6]][5@2[- 8][1 -]][[4@3 5][[6 -]11]10# 7#][8[- -8]]>*2@2]*2]!2]@32
>`).scale("<g4 g5!4>/8:major").s("sqr").clip(.9)

$:n(`<
[[-[4,2]!7]!2[-[5,3]!7]<<[-[6,4]!7][-[4,-1]!4 -!3]>[-[6,4][7,5][7#,5#][8,6]-@3]>]*4@2
[[-[7#,2]!2 - -[8#,3#]!2 -]!2<[-[9,4]!2 - -[10#,5]!2 -]!2[-[9,4]!2 - -[9,4]- 4][[-[3#,8]]!2[1 -][1,3]]>*2@2]*2
[[[-[4,2]]!4]!2[[-[5,3]]!4]<[[-[-1,4]]!4][-[6,4]-[6,4][-[6,4]][[7,5][7#,5#]][[8,6][6,4]][[8,11]-]]>]*2
[[[0# 2 5 2]!2[1# 3# 6 3#]!2]!2<[[2 4 7 4]!2[3# 5 8 5]!2]!3[[5 8 3# 8]!2[5 -!3]-]>*2@2]*2
>/8`).scale("<g3!4 g4>/8:major").s("tri").clip("<.5!4 .25>/8")

$:n(`<
[[7 -@7]!2[8 -@7]<[4 -@7][4 -@5[4 11]-3][4 -@5 11 4][4 -@6[4 4#]]>]*4@2
[[5 - - 5 6 - - 6]!2<[7 - - 7 8 - -<8[8 1]>]*2@2[7 - -[7 6]5 - 9 -][8 - 5 - 1 -!3]>*2@2]*2
[[[7 - 4 -]!2][7 - 6 - 5 - 4 -][[8 - 5 -]!2]<[8 - 4 - 5 - 6 -][4 - 8 - 4 11 1 11]>]*2
[[5 - - 5 6 -!3][6 5 - 5 6 - - 6]<[7 - - 7 8 -!3][8 7 -[7 7#]8 - -[8 8]][7 - -[7 6]5 - 9 2][8 - 5 - 1 - 8[1 3]]>*2@2]*2
>/8`).scale("g1:major").s("saw").clip(.9)

var drums=[".05:250:0:11",".05:4000:2000:1",".05:4000:4000:.9",".05:6000:4000:1",".08:1000:0:1.5"]

$:`<
[<0 1><-!3 2><2!3<3[0,3]>><3!3 2>]*28@7
[0 - 2 3 1 - 2 3 2 - 3 - 5 1 5 -]

[<0<1!7 5>><-!3<2 ->><2!3<3[0,3]>><3!3 2>]*28@7
[0 - 2 3 1 - 2 3 0 -!3 5 - 5 -]

[<<0!7 2>1><-!3<2 ->><2 2 0<3 0>><3 3<3!3 ->2>]*28@7
[[0 - 1 3]!2[0 -!3][5 - 0 0]]

[<0<1!7 5>><-!3<2!3 ->><2!3<3<[0,3]->>><3!3<2!3 3>>]*32@8

[<<[0,1]!3 1>1><- 2><2 0<2 0><0 3>><3!3 2>]*28@7
[[0,1]- 2 3 1 2 0 3[0,1]-!3 5 1 5 -]
>`.pickReset(drums).as("dec:lp:hp:gain").s("white").clip(.8)
