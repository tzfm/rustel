#!/usr/bin/env bash
# Parse the complete installer before running it, and keep shell options local.
(
  set -eo pipefail

  REPO="${RUSTELUP_REPO:-tzfm/rustel}"
  RUSTEL_DIR="${RUSTEL_DIR:-$HOME/.rustel}"
  case "$RUSTEL_DIR" in
    /*) ;;
    *) RUSTEL_DIR="$PWD/$RUSTEL_DIR" ;;
  esac
  BIN_DIR="$RUSTEL_DIR/bin"

  say() { printf 'rustelup-init: %s\n' "$1"; }
  err() { say "$1" >&2; exit 1; }
  command -v curl >/dev/null 2>&1 || err "need 'curl'"
  command -v sha256sum >/dev/null 2>&1 || command -v shasum >/dev/null 2>&1 \
    || err "need 'sha256sum' or 'shasum' to verify downloads"

  sha256_file() {
    local digest
    if command -v sha256sum >/dev/null 2>&1; then
      digest="$(sha256sum "$1")" || return 1
      printf '%s\n' "${digest%% *}"
    elif command -v shasum >/dev/null 2>&1; then
      digest="$(shasum -a 256 "$1")" || return 1
      printf '%s\n' "${digest%% *}"
    else
      err "need 'sha256sum' or 'shasum' to verify downloads"
    fi
  }

  verify_sha256() {
    local expected actual
    expected="$(tr -d '\r\n' < "$2" | tr 'A-F' 'a-f')" || err "cannot read checksum for $1"
    case "$expected" in
      *[!0-9a-f]*|"") err "invalid checksum for $1" ;;
    esac
    [ "${#expected}" -eq 64 ] || err "invalid checksum for $1"
    actual="$(sha256_file "$1")" || err "cannot hash $1"
    [ "$expected" = "$actual" ] || err "checksum mismatch for $1"
  }

  API_RESPONSE="$(curl -fsSL --connect-timeout 15 --max-time 60 "https://api.github.com/repos/$REPO/releases/latest")" \
    || err "could not find a published release at $REPO; check your connection or try again after a release is published"
  TAG="$(printf '%s\n' "$API_RESPONSE" | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"

  case "$TAG" in
    v[0-9]*) ;;
    *) err "invalid or missing release tag" ;;
  esac
  case "$TAG" in
    *[!A-Za-z0-9._-]*) err "invalid release tag: $TAG" ;;
  esac

  RUSTELUP_URL="https://github.com/$REPO/releases/download/$TAG/rustelup"

  mkdir -p "$BIN_DIR"
  [ ! -d "$BIN_DIR/rustelup" ] || err "$BIN_DIR/rustelup is a directory"
  TMP="$(mktemp -d)"
  STAGE=""
  KEEP_STAGE=""
  cleanup() {
    rm -rf "$TMP"
    if [ -n "$STAGE" ] && [ -z "$KEEP_STAGE" ]; then rm -rf "$STAGE"; fi
  }
  trap cleanup EXIT

  curl -fL --connect-timeout 15 --max-time 120 --progress-bar "$RUSTELUP_URL" -o "$TMP/rustelup" \
    || err "download failed: $RUSTELUP_URL"
  curl -fsSL --connect-timeout 15 --max-time 60 "$RUSTELUP_URL.sha256" -o "$TMP/rustelup.sha256" \
    || err "checksum download failed: $RUSTELUP_URL.sha256"
  verify_sha256 "$TMP/rustelup" "$TMP/rustelup.sha256"

  STAGE="$(mktemp -d "$BIN_DIR/.rustelup-init.XXXXXXXX")"
  cp "$TMP/rustelup" "$STAGE/rustelup"
  chmod +x "$STAGE/rustelup"

  "$STAGE/rustelup" --help >/dev/null 2>&1 \
    || err "downloaded updater failed its help check"

  [ ! -e "$BIN_DIR/rustelup" ] || cp -p "$BIN_DIR/rustelup" "$STAGE/previous"
  restore_previous() {
    if ! mv -f "$STAGE/previous" "$BIN_DIR/rustelup"; then
      KEEP_STAGE=1
      err "could not restore previous updater; backup kept at $STAGE/previous"
    fi
  }
  if ! mv -f "$STAGE/rustelup" "$BIN_DIR/rustelup"; then
    if [ -f "$STAGE/previous" ] && [ ! -e "$BIN_DIR/rustelup" ]; then
      restore_previous
    fi
    err "could not replace $BIN_DIR/rustelup"
  fi

  if ! "$BIN_DIR/rustelup" --help >/dev/null 2>&1; then
    if [ -f "$STAGE/previous" ]; then
      restore_previous
      err "installed updater failed its help check; previous updater restored"
    fi
    rm -f "$BIN_DIR/rustelup"
    err "installed updater failed its help check and was removed"
  fi
  say "installed rustelup to $BIN_DIR/rustelup"

  case "$SHELL" in
    */zsh)  PROFILE="${ZDOTDIR:-$HOME}/.zshenv" ;;
    */bash)
      PROFILE="$HOME/.bashrc"
      if [ "$(uname -s)" = Darwin ]; then
        PROFILE="$HOME/.bash_profile"
        for candidate in "$HOME/.bash_profile" "$HOME/.bash_login" "$HOME/.profile"; do
          if [ -f "$candidate" ]; then PROFILE="$candidate"; break; fi
        done
      fi ;;
    */fish) PROFILE="" ;;
    *)      PROFILE="$HOME/.profile" ;;
  esac

  if [ -n "$PROFILE" ]; then
    # Single-quote the literal directory so spaces and shell metacharacters survive.
    QUOTED_BIN_DIR=${BIN_DIR//\'/\'\\\'\'}
    PATH_LINE="export PATH='$QUOTED_BIN_DIR':\"\$PATH\""
    mkdir -p "$(dirname "$PROFILE")"
    if ! grep -Fqx -- "$PATH_LINE" "$PROFILE" 2>/dev/null; then
      printf '\n%s\n' "$PATH_LINE" >> "$PROFILE" \
        || err "updater installed, but could not update $PROFILE; add $BIN_DIR to PATH manually"
      say "added $BIN_DIR to PATH in $PROFILE"
    fi
  else
    if command -v fish >/dev/null 2>&1; then
      fish -c 'fish_add_path -- "$argv[1]"' -- "$BIN_DIR" >/dev/null 2>&1 \
        && say "added $BIN_DIR to fish PATH" \
        || say "add $BIN_DIR to your fish PATH by hand"
    else
      say "add $BIN_DIR to your fish PATH by hand"
    fi
  fi

  say "open a new terminal (or 'source' your profile), then run: rustelup"
)
