# The corpus suite reads its scores and goldens back byte for byte, and hashes
# what they produce. A checkout that rewrote their line endings would change
# what is measured, so they are LF wherever they land.
crates/runtime/tests/e2e/** text eol=lf

# Some imported scores intentionally retain upstream trailing whitespace.
crates/runtime/tests/e2e/scores/** whitespace=-trailing-space,-blank-at-eof

# The built-in theme document is data, so its line endings are LF wherever
# it lands. The ASCII art it once sat beside moved to rustel-studio-themes,
# whose own attributes keep those files byte-exact.
crates/studio/src/themes/** text eol=lf

# The studio e2e suite compares its goldens as text; the comparison also
# normalises CRLF itself, so a checkout with eol rewriting stays correct.
crates/studio-e2e/goldens/** text eol=lf

# check-engine.sh compares the base engine profile's dependency snapshot with
# cargo's output line for line, so the snapshot is LF wherever it lands.
.github/scripts/engine-base-dependencies.txt text eol=lf
